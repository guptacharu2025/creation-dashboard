  <actions>
    <action caption='Filter1' name='[Action1_3743215487B949C2838F27D0B4313D64]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='Dashboard 1 - Sales and Profit Analysis' type='sheet' worksheet='Statewise Total Sale' />
